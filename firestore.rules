rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check collection for connection test
    match /test/{docId} {
      allow read: if true;
    }

    // Hardened Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile & Isolation
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Private Financial Data subcollection
      match /finance/{docId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
